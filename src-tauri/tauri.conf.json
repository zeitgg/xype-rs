{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xype",
  "version": "1.0.7",
  "identifier": "gg.xype.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/motion-runtime": "motion-runtime",
      "resources/masks": "masks"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xype"]
      }
    },
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/zeitgg/xype-rs/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0OUQ2MERCQjk3MUJGOTgKUldTWXYzRzUyMkNkWk5RMUl6bngrM0tYbkZ2U2FrY1daRWdRQnQybGR0THB1eGMzVmNwdUU1eEIK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "xype",
        "width": 800,
        "height": 600,
        "devtools": false,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
